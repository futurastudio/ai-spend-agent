{
  "name": "ai-spend-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "check:adapters": "node scripts/check-plugin-adapters.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:release-packages": "node scripts/check-release-packages.mjs",
    "benchmark:context": "npm run build && node scripts/benchmark-context-health.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "hono": "4.12.32",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
