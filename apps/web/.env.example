# Waitlist storage (production). Without these, signups append to
# .data/waitlist.tsv (dev fallback).
#
# Table (run once in the Supabase SQL editor or via migration):
#   create table if not exists public.waitlist (
#     id uuid primary key default gen_random_uuid(),
#     email text not null unique,
#     source_ref text not null default 'direct',
#     created_at timestamptz not null default now()
#   );
#   alter table public.waitlist add column if not exists source_ref text not null default 'direct';
#   alter table public.waitlist enable row level security;
#   -- no policies: only the service-role key (server-side) can read/write.
#
# The same two vars also power POST /api/telemetry (CLI usage telemetry).
# Its table lives in supabase/telemetry_events.sql — run that file once in
# the Supabase SQL editor. Without these vars, dev accepts and drops events.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the /api/ops/* health endpoints that the launch alerting
# workflow calls (.github/workflows/launch-alerts.yml). Generate with
#   openssl rand -hex 32
# and set the SAME value in two places:
#   1. Vercel project env (Production)
#   2. GitHub repo secret OPS_HEALTH_TOKEN
#
# Must be at least 16 characters — anything shorter is treated as unset and
# every ops endpoint answers 503 rather than authenticating a weak token.
#
# This is deliberately NOT the Supabase service-role key: this repo is public,
# so the key never enters GitHub. The worst a leak of this token exposes is
# aggregate row counts and a self-cleaning storage probe.
# Runbook: docs/RUNBOOK.md
OPS_HEALTH_TOKEN=
