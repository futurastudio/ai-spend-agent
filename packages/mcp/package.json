{
  "name": "@agent-finops/mcp",
  "version": "0.6.0",
  "description": "aibill MCP server for sourced answers about Claude Code/Codex work, cost evidence, attribution, runway, and Context Health.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "finops",
    "claude-code",
    "codex",
    "ai-spend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futurastudio/ai-spend-agent.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/futurastudio/ai-spend-agent#readme",
  "bugs": {
    "url": "https://github.com/futurastudio/ai-spend-agent/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "ai-spend-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agent-finops/core": "0.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
